// Moves SHA-256 (0x02) and identity (0x04) to the same destination and calls it. The
// precompile of the account with the higher address (identity) must be at the destination. The
// request lists 0x02 first, so it does not tell this rule from "the last entry wins";
// eth_call/call-move-two-precompiles-to-same does.
>> {"jsonrpc":"2.0","id":1,"method":"eth_simulateV1","params":[{"blockStateCalls":[{"stateOverrides":{"0x0000000000000000000000000000000000000002":{"movePrecompileToAddress":"0xc200000000000000000000000000000000000000"},"0x0000000000000000000000000000000000000004":{"movePrecompileToAddress":"0xc200000000000000000000000000000000000000"},"0xc000000000000000000000000000000000000000":{"balance":"0xe8d4a51000"}},"calls":[{"from":"0xc000000000000000000000000000000000000000","to":"0xc200000000000000000000000000000000000000","input":"0xdeadbeef"}]}]},"latest"]}
